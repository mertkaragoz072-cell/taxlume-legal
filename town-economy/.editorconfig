# Keeps whitespace consistent for anyone who opens the project without the
# Prettier extension installed. Prettier is still the authority on formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses trailing double-space for a hard line break.
trim_trailing_whitespace = false
